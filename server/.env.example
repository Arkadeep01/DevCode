# Server environment template — copy to `server/.env` (gitignored) and adjust.
# Real environment variables always win over this file.
#
# Only the variables below are listed: every other setting has a safe default
# in `src/config/env.ts` and is read from there.

# Runtime mode: development | test | production.
# A production boot refuses a local database (see DATABASE_URL below).
NODE_ENV=development

# Comma-separated list of browser origins allowed by CORS.
# In production this must be the deployed web origin, e.g. https://devcode.example.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Number of proxy hops to trust for X-Forwarded-* (or true/false).
# On Vercel the app sits behind exactly one proxy hop, so this is 1 there.
# Leave false when the app is exposed directly — trusting the header without
# a proxy lets a client spoof its own IP address.
TRUST_PROXY=false

# Secret used to sign the auth tokens. REQUIRED.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Database target. REQUIRED in production.
#
# A remote libSQL server (Turso) — REQUIRED on Vercel, where the function
# filesystem is not persistent and a local file cannot hold the data:
#   DATABASE_URL=libsql://your-db.turso.io
#
# A local SQLite file (relative paths resolve from the server/ package root),
# for development only:
#   DATABASE_URL=./data/devcode.sqlite
DATABASE_URL=./data/devcode.sqlite

# Read/write token for a remote libSQL server. REQUIRED for a remote target,
# ignored for a local file. Create one in the Turso dashboard
# (Database -> Tokens).
DATABASE_AUTH_TOKEN=

# AI coach provider: mock | openai.
# `mock` answers with deterministic templates and costs nothing;
# `openai` calls the API below and needs a key.
COACH_PROVIDER=mock

# API key for the coach provider. REQUIRED when COACH_PROVIDER=openai.
COACH_API_KEY=
