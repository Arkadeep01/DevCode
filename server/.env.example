# Server environment template — copy to `server/.env` (gitignored) and adjust.
# Real environment variables always win over this file.

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed by CORS (frontend dev server)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database target.
#
# A local SQLite file (relative paths resolve from the server/ package root):
#   DATABASE_URL=./data/devcode.sqlite
#
# A remote libSQL server (Turso) — REQUIRED on Vercel, where the function
# filesystem is not persistent and a local file cannot hold the data:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=<token>
#
# The token is only sent to a remote server and is ignored for a local file.
DATABASE_URL=./data/devcode.sqlite
# DATABASE_AUTH_TOKEN=

# A production boot refuses a local database, because a serverless function
# has no persistent filesystem. Set this to true ONLY on a self-hosted host
# or in the Docker image, where the database lives on a persistent volume.
ALLOW_LOCAL_DATABASE=false

# Auth (consumed from the schema & authentication phase onward)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI Coach (consumed by the coach provider factory)
COACH_PROVIDER=mock
COACH_MODEL=gpt-4o-mini
COACH_API_KEY=
COACH_BASE_URL=https://api.openai.com/v1
COACH_MAX_OUTPUT_TOKENS=700
COACH_DAILY_TOKEN_BUDGET=50000
COACH_RATE_LIMIT_WINDOW_MS=60000
COACH_RATE_LIMIT_MAX=10
# How long a generated coaching answer is reused for the same attempt
COACH_CACHE_TTL_MS=3600000
# Timeout for a single provider request
COACH_REQUEST_TIMEOUT_MS=30000

# --- deployment / operations -------------------------------------------------
# Number of proxy hops to trust for X-Forwarded-* (or true/false).
# Set to the number of proxies in front of the app, e.g. 1 behind one nginx.
# Leave false when the app is exposed directly — trusting the header without
# a proxy lets a client spoof its own IP address.
TRUST_PROXY=false

# Log level: silent | error | warn | info | debug
LOG_LEVEL=info

# Optional: serve the built SPA from the API (single-origin deployment).
# Relative paths resolve from the server/ package root.
# Leave unset when the web client is hosted separately.
# STATIC_DIR=../dist

# Content-Security-Policy for responses served by this API.
# CSP_ENABLED=true
# Extra origins allowed by connect-src (comma separated), e.g. a separate API host.
# CSP_CONNECT_SRC=https://api.example.com

# Sign-in throttling (per client IP): requests per window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Attempt-submission throttling (per authenticated user): requests per window.
ATTEMPT_RATE_LIMIT_MAX=60
ATTEMPT_RATE_LIMIT_WINDOW_MS=60000

# Escape hatch that lets `npm run db:seed` write to a production database.
# The guard triggers whenever the target is a remote libSQL server, or when
# NODE_ENV=production — the seed never writes to production by accident.
SEED_ALLOW_PRODUCTION=false
