# Frontend environment template — copy to `.env` (gitignored) and adjust if needed.
#
# Only variables prefixed with `VITE_` are exposed to the browser, and their
# values are inlined into the client bundle at build time. Never put a secret
# in a `VITE_*` variable.

# Base URL of the DevCode API, consumed as import.meta.env.VITE_API_BASE_URL.
#
# Leave it unset (the default) when the API is served from the same origin as
# this app — the SPA then calls the relative path `/api` and no cross-origin
# request (and therefore no CORS configuration) is needed. This is the
# recommended production setup.
#
# Set it to the absolute API base URL only when the API is hosted on a
# different origin, e.g. https://api.example.com/api. That origin must also
# be listed in the API's CORS_ORIGIN.
#
# This is the setup used by the Vercel deployment: the SPA and the API are
# two Vercel projects with two hostnames.
#
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_API_BASE_URL=https://api.example.com/api
